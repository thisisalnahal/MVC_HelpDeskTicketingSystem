@model HelpDesk.ViewModels.CreateStaffVM
@{
    ViewData["Title"] = "Create Staff Account";
}

<h2>Create Staff Account</h2>

<form asp-action="CreateStaff" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Role"></label>
        <select asp-for="Role" class="form-control">
            <option value="Agent">Agent</option>
            <option value="Dispatcher">Dispatcher</option>
        </select>
    </div>

    <div class="form-group" id="departmentGroup">
        <label asp-for="Department"></label>
        <select asp-for="Department" class="form-control">
            <option value="">-- Select --</option>
            <option value="Hardware">Hardware</option>
            <option value="Software">Software</option>
            <option value="Network">Network</option>
            <option value="Billing">Billing</option>
        </select>
    </div>

    <script>
            function toggleDepartment() {
                var role = document.querySelector('[name="Role"]').value;
                document.getElementById('departmentGroup').style.display = (role === 'Agent') ? '' : 'none';
            }
            document.addEventListener('DOMContentLoaded', function () {
                document.querySelector('[name="Role"]').addEventListener('change', toggleDepartment);
                toggleDepartment(); // run on initial load too
            });
    </script>

    <button type="submit" class="btn btn-primary">Create Staff</button>
</form>